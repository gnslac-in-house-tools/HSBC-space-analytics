<!-- La ventana de Exportar con el estilo de la app (tema Aura de app/index.html): fondo con halos, tarjetas blancas,
     botones píldora. Tres páginas: elegir (etapa y vínculos), leyendo (avance) y listo (resumen). La llena y la
     responde lib/export_window.py; los nombres x:Name y los Click son su contrato. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Analytics · Exportar" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Manrope, Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1D1B24">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F4F2EE"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#1D1B24"/>
    <SolidColorBrush x:Key="Muted" Color="#67636F"/>
    <SolidColorBrush x:Key="Line" Color="#1A1D1B24"/>
    <SolidColorBrush x:Key="Line2" Color="#2E1D1B24"/>
    <SolidColorBrush x:Key="Amber" Color="#E0A030"/>
    <SolidColorBrush x:Key="AmberInk" Color="#B07818"/>
    <FontFamily x:Key="Display">Outfit, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <LinearGradientBrush x:Key="Spectrum" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF8A65" Offset="0"/>
      <GradientStop Color="#F178B6" Offset=".3"/>
      <GradientStop Color="#8C7BF5" Offset=".55"/>
      <GradientStop Color="#5B9BFF" Offset=".8"/>
      <GradientStop Color="#5DBB8A" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Feel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value=".45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="Foreground" Value="{StaticResource Bg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,0"/>
    </Style>
    <Style x:Key="Sq" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- el selector de etapa: píldoras dentro de una cápsula, como .seg de la app -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="GroupName" Value="stage"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="15" Height="30" Padding="13,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity=".18"/></Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- casilla redonda con palomita, para los vínculos -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{StaticResource Line2}" Background="{StaticResource Surface}">
                <Path x:Name="tick" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{StaticResource Bg}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Line}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource Spectrum}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="frame" Margin="20" CornerRadius="22" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
          BorderThickness="1" MouseLeftButtonDown="drag_window">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity=".22" Color="#3C2850"/>
    </Border.Effect>
    <Grid>
      <!-- los halos del fondo (o1, o2 y o3 del tema Aura), recortados por las esquinas redondas -->
      <Rectangle RadiusX="21" RadiusY="21">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.05,0" GradientOrigin="0.05,0" RadiusX=".75" RadiusY=".55">
            <GradientStop Color="#99FFC3A0" Offset="0"/>
            <GradientStop Color="#00FFC3A0" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle RadiusX="21" RadiusY="21">
        <Rectangle.Fill>
          <RadialGradientBrush Center="1,0.35" GradientOrigin="1,0.35" RadiusX=".7" RadiusY=".55">
            <GradientStop Color="#88E7C2FF" Offset="0"/>
            <GradientStop Color="#00E7C2FF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle RadiusX="21" RadiusY="21">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.45,1.05" GradientOrigin="0.45,1.05" RadiusX=".8" RadiusY=".5">
            <GradientStop Color="#77A9CFFF" Offset="0"/>
            <GradientStop Color="#00A9CFFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <StackPanel Margin="28,22,28,24">
        <!-- encabezado: la marca, el nombre y el modelo -->
        <DockPanel Margin="0,0,0,22">
          <Button DockPanel.Dock="Right" Style="{StaticResource Sq}" Content="✕" ToolTip="Cerrar (Esc)" Click="close_click"/>
          <Image x:Name="mark" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Space Analytics" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="Medium"/>
            <TextBlock x:Name="model_info" Style="{StaticResource MonoText}" FontSize="10.5" Margin="0,1,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- 1. elegir -->
        <StackPanel x:Name="page_setup">
          <TextBlock Style="{StaticResource Eyebrow}" Text="EXPORTAR"/>
          <TextBlock Style="{StaticResource H2}" Text="Llevar el modelo a la app"/>
          <TextBlock Style="{StaticResource Feel}" Margin="0,6,0,18"
                     Text="Lee el modelo sin cambiar nada y arma un HTML con la app y los datos dentro, listo para abrir con doble clic."/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="ETAPA"/>
              <Border Background="{StaticResource Line}" CornerRadius="17" Padding="2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="stage_0" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="stage_1" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="stage_2" Style="{StaticResource Seg}"/>
                  <RadioButton x:Name="stage_3" Style="{StaticResource Seg}"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="stage_hint" Style="{StaticResource Feel}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="links_card" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="VÍNCULOS DE REVIT A INCLUIR"/>
              <StackPanel x:Name="links_panel"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="SE GUARDA EN"/>
              <TextBlock x:Name="dest_path" Style="{StaticResource MonoText}"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource Pill}" Content="Cancelar" Click="close_click"/>
            <Button x:Name="export_btn" Style="{StaticResource Primary}" Content="Exportar" IsDefault="True" Click="export_click"/>
          </StackPanel>
        </StackPanel>

        <!-- 2. leyendo -->
        <StackPanel x:Name="page_work" Visibility="Collapsed">
          <Ellipse Width="96" Height="96" Margin="0,4,0,18" HorizontalAlignment="Center">
            <Ellipse.Fill>
              <RadialGradientBrush Center=".34,.3" GradientOrigin=".34,.3" RadiusX=".75" RadiusY=".75">
                <GradientStop Color="#F2FFFFFF" Offset="0"/>
                <GradientStop Color="#F178B6" Offset=".45"/>
                <GradientStop Color="#8C7BF5" Offset=".75"/>
                <GradientStop Color="#5B9BFF" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="2"/></Ellipse.Effect>
          </Ellipse>
          <TextBlock Style="{StaticResource Eyebrow}" Text="LEYENDO EL MODELO" HorizontalAlignment="Center"/>
          <TextBlock x:Name="work_title" Style="{StaticResource H2}" Text="Respira" HorizontalAlignment="Center"/>
          <ProgressBar x:Name="progress" Style="{StaticResource Bar}" Margin="40,18,40,8" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="work_detail" Style="{StaticResource MonoText}" HorizontalAlignment="Center"/>
          <Button x:Name="cancel_btn" Style="{StaticResource Pill}" Content="Cancelar" HorizontalAlignment="Center"
                  Margin="0,20,0,0" Click="cancel_click"/>
        </StackPanel>

        <!-- 3. listo -->
        <StackPanel x:Name="page_done" Visibility="Collapsed">
          <TextBlock x:Name="done_eyebrow" Style="{StaticResource Eyebrow}" Text="LISTO"/>
          <TextBlock x:Name="done_title" Style="{StaticResource H2}"/>
          <WrapPanel x:Name="counts_panel" Margin="0,12,0,8"/>
          <TextBlock x:Name="done_lines" Style="{StaticResource Feel}" Margin="0,0,0,12"/>
          <Border x:Name="warn_card" Style="{StaticResource Card}" BorderBrush="{StaticResource Amber}" BorderThickness="3,1,1,1">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource AmberInk}" Text="AVISOS DE LA EXPORTACIÓN"/>
              <TextBlock x:Name="warn_text" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="ARCHIVOS"/>
              <TextBlock x:Name="files_text" Style="{StaticResource MonoText}" LineHeight="17"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource Pill}" Content="Abrir carpeta" Click="folder_click"/>
            <Button Style="{StaticResource Pill}" Content="Cerrar" Click="close_click"/>
            <Button x:Name="open_btn" Style="{StaticResource Primary}" Content="Abrir en la app" IsDefault="True" Click="open_click"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
