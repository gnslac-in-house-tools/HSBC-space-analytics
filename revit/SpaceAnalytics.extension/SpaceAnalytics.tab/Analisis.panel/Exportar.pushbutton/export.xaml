<!-- La ventana de Exportar con el estilo de la app (tema Aura de app/index.html): angosta y vertical, como un panel;
     fondo con halos, tarjetas blancas, botones píldora y el violeta para la acción principal (nunca negro). Tres
     páginas: elegir (vínculos), leyendo (avance) y listo (conteos, y abrir la app, el resumen o la presentación). La llena y la
     responde lib/export_window.py; los nombres x:Name y los Click son su contrato. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Analytics · Exportar" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Manrope, Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1D1B24">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F4F2EE"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#1D1B24"/>
    <SolidColorBrush x:Key="Muted" Color="#67636F"/>
    <SolidColorBrush x:Key="Line" Color="#1A1D1B24"/>
    <SolidColorBrush x:Key="Line2" Color="#2E1D1B24"/>
    <SolidColorBrush x:Key="Amber" Color="#E0A030"/>
    <SolidColorBrush x:Key="AmberInk" Color="#B07818"/>
    <SolidColorBrush x:Key="Accent" Color="#6F5CE8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5E4BD6"/>
    <FontFamily x:Key="Display">Outfit, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <LinearGradientBrush x:Key="Spectrum" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF8A65" Offset="0"/>
      <GradientStop Color="#F178B6" Offset=".3"/>
      <GradientStop Color="#8C7BF5" Offset=".55"/>
      <GradientStop Color="#5B9BFF" Offset=".8"/>
      <GradientStop Color="#5DBB8A" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Feel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="MonoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value=".45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Sq" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- casilla redonda con palomita, para los vínculos -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{StaticResource Line2}" Background="{StaticResource Surface}">
                <Path x:Name="tick" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Line}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource Spectrum}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="frame" Margin="20" CornerRadius="20" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}"
          BorderThickness="1" MouseLeftButtonDown="drag_window">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity=".22" Color="#3C2850"/>
    </Border.Effect>
    <Grid>
      <!-- los halos del fondo (o1, o2 y o3 del tema Aura), recortados por las esquinas redondas -->
      <Rectangle RadiusX="19" RadiusY="19">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.05,0" GradientOrigin="0.05,0" RadiusX=".9" RadiusY=".45">
            <GradientStop Color="#99FFC3A0" Offset="0"/>
            <GradientStop Color="#00FFC3A0" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle RadiusX="19" RadiusY="19">
        <Rectangle.Fill>
          <RadialGradientBrush Center="1,0.4" GradientOrigin="1,0.4" RadiusX=".85" RadiusY=".45">
            <GradientStop Color="#88E7C2FF" Offset="0"/>
            <GradientStop Color="#00E7C2FF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle RadiusX="19" RadiusY="19">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.4,1.05" GradientOrigin="0.4,1.05" RadiusX=".95" RadiusY=".4">
            <GradientStop Color="#77A9CFFF" Offset="0"/>
            <GradientStop Color="#00A9CFFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <StackPanel Margin="20,16,20,20">
        <!-- encabezado: la marca, el nombre y el modelo -->
        <DockPanel Margin="0,0,0,18">
          <Button DockPanel.Dock="Right" Style="{StaticResource Sq}" Content="✕" ToolTip="Cerrar (Esc)" Click="close_click"/>
          <Image x:Name="mark" Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Space Analytics" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="Medium"/>
            <TextBlock x:Name="model_info" Style="{StaticResource MonoText}" FontSize="10" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Margin="0,1,8,0"/>
          </StackPanel>
        </DockPanel>

        <!-- 1. elegir -->
        <StackPanel x:Name="page_setup">
          <TextBlock Style="{StaticResource Eyebrow}" Text="EXPORTAR"/>
          <TextBlock Style="{StaticResource H2}" Text="Llevar el modelo a la app"/>
          <TextBlock Style="{StaticResource Feel}" Margin="0,4,0,14" Text="Solo lee el modelo; no cambia nada."/>
          <Border x:Name="links_card" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="VÍNCULOS A INCLUIR"/>
              <StackPanel x:Name="links_panel"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="SE GUARDA EN"/>
              <TextBlock x:Name="dest_path" Style="{StaticResource MonoText}"/>
              <TextBlock x:Name="setup_hint" Style="{StaticResource Feel}" FontSize="11.5" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource Pill}" Content="Cancelar" Click="close_click"/>
            <Button Grid.Column="2" x:Name="export_btn" Style="{StaticResource Primary}" Content="Exportar" IsDefault="True" Click="export_click"/>
          </Grid>
        </StackPanel>

        <!-- 2. leyendo -->
        <StackPanel x:Name="page_work" Visibility="Collapsed">
          <Ellipse Width="76" Height="76" Margin="0,6,0,16" HorizontalAlignment="Center">
            <Ellipse.Fill>
              <RadialGradientBrush Center=".34,.3" GradientOrigin=".34,.3" RadiusX=".75" RadiusY=".75">
                <GradientStop Color="#F2FFFFFF" Offset="0"/>
                <GradientStop Color="#F178B6" Offset=".45"/>
                <GradientStop Color="#8C7BF5" Offset=".75"/>
                <GradientStop Color="#5B9BFF" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="2"/></Ellipse.Effect>
          </Ellipse>
          <TextBlock Style="{StaticResource Eyebrow}" Text="LEYENDO EL MODELO" HorizontalAlignment="Center"/>
          <TextBlock x:Name="work_title" Style="{StaticResource H2}" Text="Respira" HorizontalAlignment="Center"/>
          <ProgressBar x:Name="progress" Style="{StaticResource Bar}" Margin="24,16,24,8" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="work_detail" Style="{StaticResource MonoText}" HorizontalAlignment="Center"/>
          <Button x:Name="cancel_btn" Style="{StaticResource Pill}" Content="Cancelar" HorizontalAlignment="Center"
                  Margin="0,18,0,0" Click="cancel_click"/>
        </StackPanel>

        <!-- 3. listo -->
        <StackPanel x:Name="page_done" Visibility="Collapsed">
          <TextBlock x:Name="done_eyebrow" Style="{StaticResource Eyebrow}" Text="LISTO"/>
          <TextBlock x:Name="done_title" Style="{StaticResource H2}" FontSize="20"/>
          <WrapPanel x:Name="counts_panel" Margin="0,10,0,6"/>
          <TextBlock x:Name="done_lines" Style="{StaticResource Feel}" FontSize="12" LineHeight="17" Margin="0,0,0,10"/>
          <Border x:Name="warn_card" Style="{StaticResource Card}" BorderBrush="{StaticResource Amber}" BorderThickness="3,1,1,1">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource AmberInk}" Text="AVISOS"/>
              <TextBlock x:Name="warn_text" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel>
          </Border>
          <Button x:Name="open_btn" Style="{StaticResource Primary}" Content="Abrir en la app" IsDefault="True"
                  Margin="0,6,0,8" Click="open_click"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="summary_btn" Style="{StaticResource Pill}" Content="Resumen" ToolTip="Las stats en una ventana angosta" Click="summary_click"/>
            <Button Grid.Column="2" x:Name="present_btn" Style="{StaticResource Pill}" Content="Presentar" ToolTip="Directo a la presentación" Click="present_click"/>
            <Button Grid.Column="4" Style="{StaticResource Pill}" Content="Carpeta" ToolTip="Abrir la carpeta de exportaciones" Click="folder_click"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
